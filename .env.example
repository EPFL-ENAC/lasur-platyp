# Copy to .env (read by docker-compose.yml and backend/Makefile)

# Postgres
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=xxxxx
DB_NAME=platyp
#DB_PREFIX=postgresql+asyncpg

# Keycloak: local/dev on enac-it-sso2, realm external, with client roles of the backend client
#KEYCLOAK_URL=https://enac-it-sso2.epfl.ch
#KEYCLOAK_REALM=external
KEYCLOAK_API_ID=platyp-local-api
KEYCLOAK_API_SECRET=xxxxx
# false (default) for prod: own Keycloak with realm roles
KEYCLOAK_CLIENT_ROLES=true
#KEYCLOAK_TOTP=true

# LASUR web services (isochrones, OSM)
LASUR_API_URL=https://lasur-ws-dev.epfl.ch
LASUR_API_KEY=xxxxx
#LASUR_OSM_SOURCE=geneva

# Default of user self-registration, overridable by admins at runtime
#SIGNUP_ENABLED=true
#RATE_LIMIT_USERS_REGISTER=5/minute
#RATE_LIMIT_ISOCHRONES=20/minute
